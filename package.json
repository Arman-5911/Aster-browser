{
  "name": "aster-browser",
  "version": "0.7.3",
  "private": true,
  "description": "A calm, local-first desktop browser - Phase 7 prototype",
  "author": "Aster",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "dev": "npm run start",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "tsc --noEmit",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "filters:update": "node scripts/update-filters.mjs",
    "icons:build": "node scripts/generate-icon.mjs"
  },
  "build": {
    "appId": "dev.aster.browser",
    "productName": "Aster",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icons/aster.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icons/aster.ico",
      "uninstallerIcon": "resources/icons/aster.ico"
    }
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tldts": "^7.4.12",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
